# Copy to .env (never commit the real file) and export the variables, or set them in your IDE / shell.
# The scripts read ENVIRONMENT variables; nothing is hard-coded.

# ---- MySQL 8 (Experiments 1-6, 8E, 8F, 5D) ----
MYSQL_BIN=mysql                  # path of the mysql client used by tools/run_sql.py (e.g. C:\Program Files\MySQL\MySQL Server 8.0\bin\mysql.exe)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PWD=                       # your MySQL password

# ---- MongoDB 7 (Experiments 7-10) ----
MONGODB_URI=mongodb://localhost:27017
# Experiment 10 change streams need a replica set:  MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DB=hospitalDB

# ---- Neo4j 5 (Experiment 10 graph part) ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ---- Node.js API (8D) ----
PORT=3000

# ---- test aids (leave unset on a real setup) ----
# USE_MOCK_MONGO=1               # in-memory mongomock for the Python code
# USE_FAKE_MONGO=1               # in-memory fake for the Node API
